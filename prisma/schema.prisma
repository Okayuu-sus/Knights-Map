generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  FACULTY
  ADMIN
}

enum LocationType {
  BUILDING
  ROOM
  LANDMARK
  OUTDOOR_AREA
  SERVICE
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ==============================
// USER
// ==============================

model User {
  id        String   @id @default(cuid())
  username  String
  name      String
  email     String   @unique
  googleId  String   @unique
  image     String?
  role      UserRole @default(STUDENT)

  // Relationships
  organizations  Organization[]
  attendedEvents Event[] @relation("EventAttendees")
  reviewedEvents Event[] @relation("EventReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==============================
// ORGANIZATION
// ==============================

model Organization {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  email       String?
  website     String?
  logo        String?
  verified    Boolean @default(false)

  // Relationships
  members User[]
  events  Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==============================
// BUILDING
// ==============================

model Building {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  description String?
  latitude    Float
  longitude   Float
  height      Float?
  footprint   Json?
  osmId       String?
  address     String?

  // Relationships
  locations Location[]
  events    Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==============================
// LOCATION
// ==============================

model Location {
  id          String       @id @default(cuid())
  name        String
  description String?
  type        LocationType
  buildingId  String?
  roomNumber  String?
  floor       Int?
  latitude    Float?
  longitude   Float?

  // Relationships
  building Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buildingId])
  @@index([name])
}

// ==============================
// EVENT
// ==============================

model Event {
  id             String      @id @default(cuid())
  title          String
  description    String
  image          String?
  locationId     String
  organizationId String?
  buildingId     String?
  reviewedById   String?
  startAt        DateTime    @db.Timestamptz(3)
  endAt          DateTime    @db.Timestamptz(3)
  status         EventStatus @default(PENDING)
  reviewedAt     DateTime?

  // Relationships
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  building     Building?     @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  reviewedBy   User?         @relation("EventReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  attendees    User[]        @relation("EventAttendees")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([buildingId])
  @@index([reviewedById])
  @@index([status])
  @@index([startAt, endAt])
}